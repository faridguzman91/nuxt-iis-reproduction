<configuration>
	<system.webServer>
		<handlers>
			<clear />
			<add
				name="httpPlatformHandler"
				path="*"
				verb="*"
				modules="httpPlatformHandler"
				resourceType="Unspecified"
				requireAccess="Script"
			/>
		</handlers>

		<!--
			HttpPlatformHandler spawns Node.js and proxies all requests to it.

			IMPORTANT: HttpPlatformHandler forwards the FULL original URL path to Node,
			including the IIS virtual application prefix. For a request to
			  http://yourserver/MyApp/dashboard
			Node receives the path /MyApp/dashboard — the prefix is NOT stripped.

			This is why NUXT_APP_BASE_URL must be set to match the virtual app path.
			Nuxt uses it to strip the prefix when matching routes and to prepend it
			when generating links. It must also be set at BUILD TIME (before pnpm build)
			because Vite bakes the public path for JS chunks at compile time.
		-->
		<httpPlatform
			stdoutLogEnabled="true"
			stdoutLogFile="C:\inetpub\logs\LogFiles\MyApp\node.log"
			startupTimeLimit="20"
			processPath="C:\Program Files\nodejs\node.exe"
			arguments="server/index.mjs"
		>
			<environmentVariables>
				<environmentVariable name="NODE_ENV"          value="production" />
				<environmentVariable name="PORT"              value="%HTTP_PLATFORM_PORT%" />

				<!--
					THE KEY VARIABLE: must match the IIS virtual application alias.
					Set this to the same value before running `nuxt build`.

					Example: if your IIS virtual app alias is "MyApp", set:
					  NUXT_APP_BASE_URL=/MyApp/

					Without this, Nuxt's router does not strip the sub-path prefix
					and all routes 404. With it set, sendRedirect() still does NOT
					prepend it automatically — that is the bug this repo reproduces.
				-->
				<environmentVariable name="NUXT_APP_BASE_URL" value="/MyApp/" />
			</environmentVariables>
		</httpPlatform>

		<httpProtocol>
			<customHeaders>
				<remove name="X-Powered-By" />
			</customHeaders>
		</httpProtocol>
	</system.webServer>
</configuration>
